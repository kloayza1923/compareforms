# Herramienta mensual (legacy). El portal V1 usa documents/ en su propio entorno.
COMPAREFORMS_DATA_ROOT=./dataset
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b-it-qat
OLLAMA_TIMEOUT_SECONDS=180
MAX_DIFF_SNIPPETS=30
OCR_ENABLED=true
OCR_LANG=spa
OCR_DPI=200
OCR_MIN_CHARS=30

# Shared only with Roboti backend; use >=32 random characters. Requires aitrol auth.
COMPAREFORMS_PROXY_TOKEN=
