# TEMPLATE ONLY. Set a real internal DNS name/certificate and validate `nginx -t`.
# Ensure nginx can traverse the parent directories and read frontend-runtime only.
# Never alias documents/, the repository root, models/ or a virtualenv.
server {
    listen 443 ssl;
    server_name compareforms.example.internal;
    ssl_certificate /etc/ssl/compareforms/fullchain.pem;
    ssl_certificate_key /etc/ssl/compareforms/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 513m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

    location ^~ /api/v1/ {
        proxy_pass http://127.0.0.1:8015;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_request_buffering on;
        # Uploads may be spooled by nginx; restrict its temporary storage/retention.
    }

    # Old tabs retain working chunks across release switches. Only static assets
    # are public, never release manifests or medical files. Keep releases retained.
    location ~ "^/releases/(?<release_id>[A-Za-z0-9][A-Za-z0-9_-]{0,63})/assets/(?<asset_name>[A-Za-z0-9_.-]+\.(?:js|css|svg|png|webp|ico|woff2?|ttf|jpg|jpeg|gif))$" {
        alias /home/sistemas201/projects/compareforms/frontend-runtime/releases/$release_id/assets/$asset_name;
        expires 1y;
        # Do not add location-level add_header: nginx would stop inheriting CSP.
    }
    location /releases/ { return 404; }
    location ~ /\. { return 404; }
    location = /index.html {
        alias /home/sistemas201/projects/compareforms/frontend-runtime/current/index.html;
        expires -1;
    }
    location / {
        rewrite ^ /index.html last;
    }
}
